# Copy this file to .env and fill in your values. .env is git-ignored.
#
#   cp .env.example .env
#
# `make dev` and `make run` load it for you. To run the server by hand, as in
# ProfessorMAC: source .env && go run ./cmd/pmac-chat

# OpenAI API key, from https://platform.openai.com/api-keys. Only the Go
# server reads it; it is never sent to the browser.
export OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model for chat answers (optional, defaults to gpt-5-mini).
# export OPENAI_MODEL=gpt-5-mini

# Every OpenAI call is logged as a one-line summary. Set to true to also log
# the full request and response JSON (long, but shows exactly what's sent).
# export OPENAI_LOG_BODIES=true

# User-Agent for the weather tool's calls to api.weather.gov and OpenStreetMap
# Nominatim (no keys needed). Both ask apps to identify themselves with contact
# info, e.g. "professor-mac-chat/0.1 (you@example.com)". Optional.
# export WEATHER_USER_AGENT="professor-mac-chat/0.1 (you@example.com)"

# Port for the Go server (optional, defaults to 8080). Same name as ProfessorMAC.
# export PROFESSOR_MAC_API_PORT=8080
